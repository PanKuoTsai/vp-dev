From: VP Studio
Subject: [PATCH] libqemu: register device state for savevm

libqemu skips vmstate registration of every qdev device (CONFIG_LIBQEMU),
so qmp_xen_save_devices_state and savevm only see the CPUs, the timers and
slirp. A checkpoint loaded into a new simulation then leaves the GIC, the
virtio devices and the PCIe host in their reset state, and the guest hangs
in WFI with its timer interrupt pending.

Register the device state again. The concern in the removed comment, an
idstr collision for devices whose bus path is not unique in the
SystemC-bridged topology, is handled by a warning instead of failing the
realize: that device's state is then not saved. With QBox's Ubuntu AArch64
platform no collision occurs.

libqemu_device_vmstate lets a tool tell a patched libqemu from an
unpatched one (dlsym).

Applies to libqemu-v11.0-v0.17 (build/_deps/libqemu-src of QBox).
---
diff --git a/hw/core/qdev.c b/hw/core/qdev.c
index 254b63d08..e901939f3 100644
--- a/hw/core/qdev.c
+++ b/hw/core/qdev.c
@@ -44,6 +44,14 @@
 static bool qdev_hot_added = false;
 bool qdev_hot_removed = false;
 
+#ifdef CONFIG_LIBQEMU
+/*
+ * Present when device state is registered for savevm (VP Studio checkpoints
+ * look it up with dlsym to tell a patched libqemu from an unpatched one).
+ */
+int libqemu_device_vmstate = 1;
+#endif
+
 const VMStateDescription *qdev_get_vmsd(DeviceState *dev)
 {
     DeviceClass *dc = DEVICE_GET_CLASS(dev);
@@ -533,14 +541,6 @@ static void device_set_realized(Object *obj, bool value, Error **errp)
             }
         }
 
-#ifndef CONFIG_LIBQEMU
-        /*
-         * libqemu embeds QEMU into a SystemC co-simulation and does not
-         * drive savevm / live migration. Skipping vmstate registration
-         * avoids idstr collisions for devices whose bus path is not unique
-         * in the SystemC-bridged topology (e.g. qbox virtio-mmio proxies
-         * which are never sysbus_mmio_map()'d).
-         */
         if (qdev_get_vmsd(dev)) {
             if (vmstate_register_with_alias_id(VMSTATE_IF(dev),
                                                VMSTATE_INSTANCE_ID_ANY,
@@ -548,10 +548,20 @@ static void device_set_realized(Object *obj, bool value, Error **errp)
                                                dev->instance_id_alias,
                                                dev->alias_required_for_version,
                                                &local_err) < 0) {
+#ifdef CONFIG_LIBQEMU
+                /*
+                 * libqemu: register the device state so that it can be saved
+                 * and loaded (checkpoints), but an idstr collision in the
+                 * SystemC-bridged topology only costs that device's state.
+                 */
+                warn_reportf_err(local_err, "%s: device state not saved: ",
+                                 object_get_typename(OBJECT(dev)));
+                local_err = NULL;
+#else
                 goto post_realize_fail;
+#endif
             }
         }
-#endif /* CONFIG_LIBQEMU */
 
         /*
          * Clear the reset state, in case the object was previously unrealized
@@ -605,11 +615,9 @@ static void device_set_realized(Object *obj, bool value, Error **errp)
         QLIST_FOREACH(bus, &dev->child_bus, sibling) {
             qbus_unrealize(bus);
         }
-#ifndef CONFIG_LIBQEMU
         if (qdev_get_vmsd(dev)) {
             vmstate_unregister(VMSTATE_IF(dev), qdev_get_vmsd(dev), dev);
         }
-#endif /* CONFIG_LIBQEMU */
         if (dc->unrealize) {
             dc->unrealize(dev);
         }
@@ -625,11 +633,9 @@ child_realize_fail:
         qbus_unrealize(bus);
     }
 
-#ifndef CONFIG_LIBQEMU
     if (qdev_get_vmsd(dev)) {
         vmstate_unregister(VMSTATE_IF(dev), qdev_get_vmsd(dev), dev);
     }
-#endif /* CONFIG_LIBQEMU */
 
 post_realize_fail:
     g_free(dev->canonical_path);
