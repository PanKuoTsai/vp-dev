{
  "platform": "mau-sysbus.platform.json",
  "description": "The system bus as a shared bus or as a crossbar, as the CPU keeps more accesses in flight: what the CPU gets, and whether the display and the DMA keep their 6000 MB/s.",
  "sweep": [
    { "param": "sysbus.topology", "values": ["shared", "crossbar"] },
    { "param": "cpu.max_outstanding", "values": [4, 8, 16, 32, 64] }
  ],
  "metrics": [
    "initiators.cpu.bandwidthMBps",
    "initiators.cpu.latencyNs.p99",
    "initiators.display.bandwidthMBps",
    "initiators.dma.bandwidthMBps",
    "buses.sysbus.requestUtilization",
    "buses.sysbus.responseUtilization",
    "memories.ddr0.dataBusUtilization",
    "memories.ddr1.dataBusUtilization"
  ],
  "checks": [
    { "metric": "initiators.display.bandwidthMBps", "min": 5900 },
    { "metric": "initiators.dma.bandwidthMBps", "min": 5900 }
  ]
}
