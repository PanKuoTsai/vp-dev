{
  "private": true,
  "name": "vp-studio-electron",
  "version": "0.2.9",
  "main": "scripts/theia-electron-main.js",
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "VP Studio",
        "defaultTheme": {
          "light": "light",
          "dark": "dark"
        },
        "preferences": {
          "files.enableTrash": false,
          "security.workspace.trust.enabled": false
        }
      }
    },
    "backend": {
      "config": {}
    }
  },
  "dependencies": {
    "@theia/core": "1.74.3",
    "vp-studio-menu": "0.2.9",
    "@theia/editor": "1.74.3",
    "@theia/filesystem": "1.74.3",
    "@theia/markers": "1.74.3",
    "@theia/messages": "1.74.3",
    "@theia/monaco": "1.74.3",
    "@theia/navigator": "1.74.3",
    "@theia/preferences": "1.74.3",
    "@theia/process": "1.74.3",
    "@theia/terminal": "1.74.3",
    "@theia/workspace": "1.74.3",
    "@theia/task": "1.74.3",
    "@theia/debug": "1.74.3",
    "@theia/plugin-ext": "1.74.3",
    "@theia/plugin-ext-vscode": "1.74.3",
    "@theia/output": "1.74.3",
    "@theia/outline-view": "1.74.3",
    "@theia/file-search": "1.74.3",
    "@theia/search-in-workspace": "1.74.3",
    "@theia/keymaps": "1.74.3",
    "@theia/variable-resolver": "1.74.3",
    "@theia/userstorage": "1.74.3",
    "@theia/vsx-registry": "1.74.3",
    "@theia/electron": "1.74.3"
  },
  "devDependencies": {
    "@theia/cli": "1.74.3",
    "electron": "42.11.16",
    "electron-builder": "25.1.8"
  },
  "scripts": {
    "build": "theia build --mode production",
    "rebuild": "theia rebuild:electron",
    "start": "theia start --plugins=local-dir:../plugins",
    "package": "electron-builder --linux",
    "package:dir": "electron-builder --linux --dir"
  }
}
